---
import BaseLayout from "../layouts/BaseLayout.astro";
import headshot from "../assets/images/headshot.jpg";
---

<BaseLayout>
  <div class="hero">
    <div class="hero__content">
      <h1>Michael Zhan</h1>
      <h2>SWE @ Bloomberg</h2>
      <h3>
        <a
          href="https://www.linkedin.com/in/michaelzhan1/"
          target="_blank"
          rel="noopener noreferrer">[LinkedIn]</a
        >
        <a
          href="https://www.github.com/michaelzhan1/"
          target="_blank"
          rel="noopener noreferrer">[GitHub]</a
        >
      </h3>
    </div>
    <div class="hero__image">
      <img src={headshot.src} alt="Michael Zhan" width="244" height="244" />
    </div>
  </div>
  <div class="intro">
    <p>
      Hi there, I'm Michael! I currently work as a software engineer at
      Bloomberg, where I develop full stack systems for a web content management
      platform. Welcome to my little corner of the internet where you can learn
      more about me, read some of my ramblings, and see some of my projects.
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    justify-content: space-between;

    .hero__content {
      display: flex;
      flex-direction: column;
      justify-content: center;

      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 2.5rem;
      }

      h2 {
        font-size: 1.75rem;
        font-weight: 300;
        line-height: 1.25;
      }

      h3 {
        font-weight: 300;
        line-height: 1.25;
        margin-top: 0.75rem;

        a {
          color: var(--color-text);
          text-decoration: none;

          &:hover {
            color: var(--color-text-hover);
          }
        }
      }
    }

    .hero__image {
      margin-top: 0.75rem;

      img {
        border-radius: 50%;
      }
    }

    @media (max-width: 650px) {
      flex-direction: column;
      align-items: center;
      text-align: center;

      .hero__content {
        h2 {
          margin-top: 0.25rem;
        }

        h3 {
          margin-top: 0.25rem;
        }
      }
    }
  }

  .intro {
    margin-top: 1rem;

    p {
      font-size: 1.125rem;
    }
  }
</style>

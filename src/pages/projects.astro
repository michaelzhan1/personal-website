---
import PageTitle from "../components/PageTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import GameOfLifeProject from "../components/projects/GameOfLife.astro";
import MazeProject from "../components/projects/Maze.astro";
import MockLogSystemProject from "../components/projects/MockLogSystem.astro";
import MonkeyInterpreterProject from "../components/projects/MonkeyInterpreter.astro";
import PickleballReserveProject from "../components/projects/PickleballReserve.astro";
import SortVisualizerProject from "../components/projects/SortVisualizer.astro";
import SplitProject from "../components/projects/Split.astro";
import StockDataGeneratorProject from "../components/projects/StockDataGenerator.astro";
import WebsiteProject from "../components/projects/Website.astro";
import BioRxivProject from "../components/projects/BioRxiv.astro";

const projects = [
  WebsiteProject,
  StockDataGeneratorProject,
  MockLogSystemProject,
  MonkeyInterpreterProject,
  PickleballReserveProject,
  SplitProject,
  MazeProject,
  GameOfLifeProject,
  SortVisualizerProject,
  BioRxivProject,
];
---

<BaseLayout title="Projects" description="Michael Zhan's projects">
  <section class="projects">
    <PageTitle title="Projects" />
    <div class="projects__content">
      {projects.map((Project) => <Project />)}
    </div>
  </section>
</BaseLayout>

<style>
  .projects__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

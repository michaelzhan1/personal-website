---
import Link from "../Link.astro";
import ProjectTemplate from "../ProjectTemplate.astro";
---

<ProjectTemplate
  title="Pickleball Reservation System"
  link="https://github.com/michaelzhan1/pickleball-reserve"
>
  <p>
    A manager for automating pickleball reservations. Cron jobs automatically
    attempt court reservations through <Link
      href="https://playwright.dev/"
      text="Playwright"
    /> and are managed through an Express.js server. This is something I built to
    help my family out, who are currently addicted to pickleball. I first used <Link
      href="https://pptr.dev/"
      text="Puppeteer"
    /> to manage browser interactions, but later switched to Playwright after finding
    more success with it at work.
  </p>
</ProjectTemplate>

---
import Link from "../Link.astro";
import ProjectTemplate from "../ProjectTemplate.astro";
---

<ProjectTemplate
  title="Pickleball Reservation System"
  link="https://github.com/michaelzhan1/pickleball-reserve"
>
  <p>
    A manager for automated pickleball reservations. Cron jobs run automatically
    to attempt court reservations through <Link
      href="https://playwright.dev/"
      text="Playwright"
    />, and are managed through simple CRUD operations. This is something I
    built to help my family out, who have been addicted to pickleball. It was
    originally built with <Link href="https://pptr.dev/" text="Puppeteer" />,
    but I found more success with Playwright after using it at work.
  </p>
</ProjectTemplate>

---
import ProjectTemplate from "../ProjectTemplate.astro";
---

<ProjectTemplate
  title="Pickleball Reservation System"
  link="https://github.com/michaelzhan1/pickleball-reserve"
>
  <p>
    A manager for automated pickleball reservations. Cron jobs run automatically
    to attempt court reservations through <a
      href="https://playwright.dev/"
      rel="noreferrer noopener">Playwright</a
    >, and are managed through simple CRUD operations. This is something I built
    to help my family out, who have been addicted to pickleball. It used to use
    <a href="https://pptr.dev/" rel="noreferrer noopener">Puppeteer</a>, but I
    found more success with Playwright after using it at work.
  </p>
</ProjectTemplate>

---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  content: string | typeof Icon;
  className?: string;
  ariaLabel?: string;
}

const { href, content, className, ariaLabel } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className} aria-label={ariaLabel}>
  {content}
</a>
